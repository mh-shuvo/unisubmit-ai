# Secrets have no defaults: the app, the worker and docker compose refuse to
# start until they are set. Generate each with: openssl rand -hex 32
APP_SECRET=
AI_SERVICE_TOKEN=
QDRANT_API_KEY=
# Docker only. An existing pgdata volume keeps the password it was created with.
POSTGRES_PASSWORD=

DATABASE_URL=sqlite:///./unisubmit.db
AI_SERVICE_URL=http://127.0.0.1:8001
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=unisubmit@example.edu
SMTP_USE_TLS=true

# AI service defaults (used when exported to the AI service process)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:32b
EMBEDDING_MODEL=BAAI/bge-m3
QDRANT_URL=http://127.0.0.1:6333

# Docker only: where containers reach Ollama and the AI service. The defaults
# reach both on the host, which is how the Mac demo runs them.
# DOCKER_OLLAMA_URL=http://host.docker.internal:11434
# DOCKER_AI_SERVICE_URL=http://host.docker.internal:8001
