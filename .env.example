# Copy to .env and fill in; never commit .env. One file serves the web app and
# worker (UNISUBMIT_*), the AI service (plain names) and docker compose.

# Secrets have no defaults: the app, the worker, the AI service and docker
# compose refuse to start until they are set. Generate each with:
#   openssl rand -hex 32
UNISUBMIT_SECRET_KEY=
AI_SERVICE_TOKEN=
UNISUBMIT_AI_SERVICE_TOKEN=${AI_SERVICE_TOKEN}
# Docker only. An existing pgdata volume keeps the password it was created with.
POSTGRES_PASSWORD=

# Web app and worker when run natively (`uv run ...`); compose sets its own.
UNISUBMIT_DATABASE_URL=postgresql+psycopg://unisubmit:CHANGE_ME@127.0.0.1:5433/unisubmit
UNISUBMIT_STORAGE_DIR=./storage
UNISUBMIT_AI_SERVICE_URL=http://127.0.0.1:8001
UNISUBMIT_OLLAMA_URL=http://127.0.0.1:11434
UNISUBMIT_OLLAMA_MODEL=qwen3:14b
UNISUBMIT_SMTP_HOST=
UNISUBMIT_SMTP_PORT=587
UNISUBMIT_SMTP_USERNAME=
UNISUBMIT_SMTP_PASSWORD=
UNISUBMIT_SMTP_FROM=unisubmit@example.edu
UNISUBMIT_SMTP_USE_TLS=true

# AI service (run natively on the Mac; see docs/runbook-demo-mac.md).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b                # qwen3:32b needs about 20 GB of free memory
EMBEDDING_MODEL=BAAI/bge-m3
QDRANT_URL=http://127.0.0.1:6333
# Unset lets FlagEmbedding choose: CUDA, then Apple MPS, then CPU.
# EMBEDDING_DEVICE=mps
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=4096
OLLAMA_JSON_THINK=false

# Docker only: where containers reach Ollama and the AI service. The defaults
# reach both on the host, which is how the Mac demo runs them.
# DOCKER_OLLAMA_URL=http://host.docker.internal:11434
# DOCKER_AI_SERVICE_URL=http://host.docker.internal:8001
