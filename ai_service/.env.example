# Same value as AI_SERVICE_TOKEN in the web app's .env; required.
AI_SERVICE_TOKEN=
# Same value as QDRANT_API_KEY given to the Qdrant container; required with the
# provided docker-compose.yml.
QDRANT_API_KEY=

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:32b
EMBEDDING_MODEL=BAAI/bge-m3
QDRANT_URL=http://127.0.0.1:6333
# Unset lets FlagEmbedding choose: CUDA, then Apple MPS, then CPU.
# EMBEDDING_DEVICE=mps

# Structured generation budget; used even when upgrading an existing .env.
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=4096
OLLAMA_JSON_THINK=false
